# Chave secreta do link. Gere uma string longa e aleatória (32+ caracteres).
# O acesso é feito uma vez por https://SEU-APP.vercel.app/?k=ESSA_CHAVE
APP_KEY=troque-por-uma-chave-longa-e-aleatoria

# Credencial do Firebase (Service Account) em uma linha só, JSON completo.
# Firebase Console > Configurações do projeto > Contas de serviço > Gerar nova chave privada
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"...","token_uri":"https://oauth2.googleapis.com/token"}
